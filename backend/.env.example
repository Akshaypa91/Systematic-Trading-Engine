# .env.example — copy to .env and fill in real values
NODE_ENV=development
PORT=3000

# ── Database: TiDB Cloud (MySQL protocol via mysql2) ──────────────────────
# See config/database.js. Two ways to configure — pick one:
#   1. DATABASE_URL — a single mysql:// connection string (wins if set).
#   2. TIDB_HOST / TIDB_PORT / TIDB_USERNAME / TIDB_PASSWORD / TIDB_DATABASE
#      — used only if DATABASE_URL is unset.
# Get these from the TiDB Cloud console: your cluster -> Connect.
DATABASE_URL=mysql://user:password@gateway01.<region>.prod.aws.tidbcloud.com:4000/trading_engine
TIDB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_DATABASE=trading_engine
TIDB_USERNAME=
TIDB_PASSWORD=
# Optional: path to a CA bundle if you need to pin a specific certificate
# (e.g. TiDB Dedicated with a private CA). Not required for TiDB Serverless
# — its certs are publicly trusted and validate against the OS trust store.
TIDB_SSL_CA=
DB_POOL_MAX=10

JWT_SECRET=
JWT_EXPIRY_SECONDS=604800

TWELVEDATA_API_KEY=
FINNHUB_API_KEY=

UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/api/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

SIM_INTERVAL_MS=3000
MARKET_DATA_CACHE_TTL_MS=8000
# .env.example — copy to .env and fill in real values
NODE_ENV=development
PORT=3000

# Postgres-compatible connection string (the app currently runs against
# CockroachDB — see config/database.js). The old DB_HOST/DB_PORT/DB_USER/
# DB_PASSWORD/DB_NAME (MySQL-style) vars below were left over from an
# earlier version of this app and are no longer read anywhere; DATABASE_URL
# is the only DB var actually used.
DATABASE_URL=postgresql://user:password@host:26257/trading_engine?sslmode=verify-full
# Set to 'true' once your DB host's TLS certificate chain is confirmed to
# validate cleanly (recommended for production). Defaults to false to match
# prior behavior with self-signed/managed-DB certs.
DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=
JWT_EXPIRY_SECONDS=604800

TWELVEDATA_API_KEY=
FINNHUB_API_KEY=

UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/api/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

SIM_INTERVAL_MS=3000
MARKET_DATA_CACHE_TTL_MS=8000
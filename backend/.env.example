# .env.example — copy to .env and fill in real value's
NODE_ENV=development
PORT=3000

# ── Database: TiDB Cloud (MySQL protocol via mysql2)
DATABASE_URL=
TIDB_HOST=
TIDB_PORT=
TIDB_DATABASE=
TIDB_USERNAME=
TIDB_PASSWORD=
TIDB_SSL_CA=
DB_POOL_MAX=10

JWT_SECRET=
JWT_EXPIRY_SECONDS=604800

TWELVEDATA_API_KEY=
FINNHUB_API_KEY=

UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/api/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

SIM_INTERVAL_MS=3000
MARKET_DATA_CACHE_TTL_MS=8000
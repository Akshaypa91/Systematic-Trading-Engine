{
  "name": "systematic-trading-engine",
  "version": "1.0.0",
  "description": "Production-grade Systematic Trading Engine for NSE/BSE",
  "main": "src/app.js",
  "scripts": {
    "start": "node backend/src/app.js",
    "dev": "nodemon src/app.js",
    "test": "node tests/run-tests.js",
    "backtest:sample": "node scripts/run-sample-backtest.js",
    "db:migrate": "node backend/scripts/migrate.js",
    "db:seed": "node backend/scripts/setup-complete.js",
    "health": "node scripts/health-check.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:restart": "docker compose restart app",
    "deploy": "bash scripts/deploy.sh --migrate"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "google-auth-library": "^10.6.2",
    "mathjs": "^12.2.1",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.5",
    "technicalindicators": "^3.1.0",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

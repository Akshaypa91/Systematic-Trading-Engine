# Systematic Trading Engine — Environment Configuration
NODE_ENV=production
PORT=3000

# built from the TIDB_* vars. Get these from the TiDB Cloud console under
DATABASE_URL=
TIDB_HOST=
TIDB_PORT=
TIDB_DATABASE=
TIDB_USERNAME=
TIDB_PASSWORD=
TIDB_SSL_CA=
DB_POOL_MAX=
DB_ACQUIRE_TIMEOUT=

# Security
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_HEX

# Logging
# Levels: error | warn | info | http | debug | silly
LOG_LEVEL=info
LOG_DIR=./logs

# ── Capital & Risk
DEFAULT_CAPITAL=1000000
MAX_RISK_PER_TRADE_PCT=0.02
MAX_DAILY_LOSS_PCT=0.05
DEFAULT_STOP_LOSS_PCT=0.02
DEFAULT_TAKE_PROFIT_PCT=0.04
MAX_OPEN_POSITIONS=10
MAX_PORTFOLIO_EXPOSURE=0.95
MAX_SINGLE_ASSET_PCT=0.20
VOL_TARGET_ANNUAL=0.15

# ── Transaction Costs
USE_SIMPLIFIED_COSTS=true
BROKERAGE_PCT=0.0003
BROKERAGE_FLAT=20
STT_SELL_PCT=0.001
STAMP_DUTY_PCT=0.00015
DP_CHARGE_FLAT=13.5
GST_RATE=0.18

# ── Backtest
BACKTEST_COMMISSION_PCT=0.0003
BACKTEST_SLIPPAGE_PCT=0.0005
BACKTEST_DEFAULT_CAPITAL=1000000

# ── NSE Data Feed
NSE_REQUEST_TIMEOUT=15000
NSE_RETRY_ATTEMPTS=3
NSE_RETRY_DELAY_MS=2000
NSE_RATE_LIMIT_PER_MINUTE=30

# ── Cache
CACHE_TTL_SECONDS=300
MARKET_DATA_CACHE_TTL=60

# ── Live Signal Engine 
SIGNAL_INTERVAL_MS=300000
SIGNAL_LOOKBACK=250
SYMBOL_DELAY_MS=300
PAPER_TRADE_AUTO=true
MIN_SIGNAL_CONFIDENCE=0.35

# ── Execution Engine
EXEC_DELAY_MS=150
TRADE_COOLDOWN_MIN=60
SL_COOLDOWN_MULT=3.0
TP_COOLDOWN_MULT=0.5
MIN_TRADE_VALUE=1000
MAX_TRADE_PCT=0.30
PARTIAL_FILL_ENABLED=true
DB_RETRY_ATTEMPTS=3

# ── Strategy Weights
WEIGHT_MEAN_REVERSION=0.35
WEIGHT_MA_CROSSOVER=0.35
WEIGHT_RSI=0.30

# ── Regime Detection
REGIME_ADX_PERIOD=14
REGIME_SLOPE_PERIOD=20
REGIME_TREND_ADX_MIN=25
REGIME_SIDEWAYS_ADX_MAX=20

# ── Portfolio
PORTFOLIO_MAX_ASSETS=10
PORTFOLIO_ALLOC_METHOD=equal

# ── Walk-Forward 
WF_WINDOWS=3
WF_IS_FRACTION=0.70
WF_PURGE_BARS=5
WF_EMBARGO_BARS=5

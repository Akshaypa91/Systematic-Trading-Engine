# Dependencies
node_modules/

# Build output
dist/
frontend/dist/

# Environment files — never commit real secrets.
# NOTE: package-lock.json is intentionally NOT ignored — it MUST be committed
# so `npm ci` works in CI and deployments are reproducible.
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Vercel
.vercel

# OS
.DS_Store

# Logs — these were previously tracked in git (backend/logs/*, logs/*),
# which means every run adds noisy diffs. Ignored going forward; run
# `git rm -r --cached logs backend/logs` once to untrack the existing ones.
logs/
backend/logs/
*.log
